# Salin file ini jadi .env lalu isi nilai asli Anda — .env TIDAK masuk git
# (sudah ada di .gitignore).
#
# ERA GO MURNI (1.3.0): layanan Python dihapus — BACKEND_URL kini
# menunjuk backend GO yang sama dengan API_URL. OSCAR (asisten AI),
# AI Developer, dan ramalan hidup di backend Go.

# NextAuth / Auth.js — kunci tanda tangan cookie sesi (string acak panjang,
# harus SAMA di semua environment yang berbagi sesi)
AUTH_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
AUTH_TRUST_HOST=true

# Backend Go (server-side saja — tanpa awalan NEXT_PUBLIC_, tidak sampai
# browser). Default sudah http://localhost:8080 bila tidak diisi.
API_URL=http://localhost:8080

# ERA GO MURNI: pintu /api/v1/assistant/* dan /api/v1/forecast/* kini
# dilayani backend Go (port sama dengan API_URL). Di dalam docker
# compose nilai ini otomatis http://backend:8080.
BACKEND_URL=http://localhost:8080

# ===== OSCAR — konfigurasi LLM (env = fallback; pengaturan dari UI =====
# ===== Pengaturan -> Asisten AI menimpa nilai ini tanpa restart)  =====
# Endpoint standar OpenAI-compatible — cocok untuk Groq/OpenAI/OpenRouter/
# Ollama lokal (http://host:11434/v1, tanpa kunci).
LLM_ENABLED=true
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Batas laju + cache asisten (default sudah baik; naikkan bila perlu).
ASSISTANT_RATE_LIMIT_PER_HOUR=12
ASSISTANT_CACHE_SECONDS=600
# Batas laporan AI Developer per jam (endpoint ber-PIN).
DEV_AI_RATE_LIMIT_PER_HOUR=6
# Geo lookup kota asal IP di jejak audit (false = nol trafik keluar).
GEO_LOOKUP_ENABLED=true
