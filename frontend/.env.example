# Salin file ini jadi .env lalu isi nilai asli Anda — .env TIDAK masuk git
# (sudah ada di .gitignore).
#
# v2.1.0 (era Go murni): frontend TIDAK lagi punya kredensial database —
# seluruh data datang dari backend-go lewat API_URL. Tidak ada Prisma.

# NextAuth / Auth.js — kunci tanda tangan cookie sesi (string acak panjang,
# harus SAMA di semua environment yang berbagi sesi)
AUTH_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
AUTH_TRUST_HOST=true

# Backend-go (server-side saja — tanpa awalan NEXT_PUBLIC_, tidak sampai
# browser). Default sudah http://localhost:8080 bila tidak diisi.
API_URL=http://localhost:8080

# Layanan ML FastAPI (dipakai widget Ramalan Pendapatan & Saran Restock;
# server-side saja). Default http://127.0.0.1:8000 bila tidak diisi.
BACKEND_URL=http://127.0.0.1:8000
