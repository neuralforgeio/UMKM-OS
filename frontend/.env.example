# PostgreSQL connection used by Prisma CLI, PrismaClient and the seed script
# Native dev channel uses port 5432, Docker channel uses 5433
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# NextAuth v5 (Auth.js) session secret, required in production
# Generate with a 32-byte random value encoded as base64
AUTH_SECRET="REPLACE_WITH_RANDOM_BASE64"

# Trust the host header (needed outside Vercel, e.g. Docker or reverse proxy)
AUTH_TRUST_HOST=true
