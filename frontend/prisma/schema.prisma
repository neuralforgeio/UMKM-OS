// =====================================================================
// UMKM OS — database schema (Prisma)
// ---------------------------------------------------------------------
// The schema is OWNED BY THE FRONTEND (blueprint, chapter 8): the
// Next.js app is the single writer, while the FastAPI ML service
// connects READ-ONLY for forecasting queries.
//
// Conventions:
//   - Money columns use Decimal(12,2) — NEVER Float for currency.
//   - ids are UUIDs generated by Prisma (client side).
//   - TransactionItem stores priceAtSale as a historical snapshot, so
//     old receipts stay accurate even when product prices change later.
//   - Soft deletes via isActive — sales history must never be lost.
// =====================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

/// Application roles — drives RBAC in frontend pages and API routes.
enum Role {
  OWNER // full access: all outlets, reports, settings, user management
  KASIR // point-of-sale access for their assigned outlet
  DEVELOPER // platform super-user: cross-outlet console, account management, audit logs
}

/// Payment methods accepted at the cashier.
enum PaymentMethod {
  CASH
  QRIS
  DEBIT
}

/// Lifecycle of a transaction.
enum TransactionStatus {
  COMPLETED
  REFUNDED
}

/// Direction of a stock movement. IN adds stock (owner restock or the
/// reconstructed opening balance), SALE is written atomically with the
/// cashier checkout, ADJUST is reserved for future manual corrections.
enum StockMovementType {
  IN
  SALE
  ADJUST
}

// ---------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------

/// Application user (owner or cashier).
model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  /// Bcrypt hash — the plain password is never stored.
  password  String
  role      Role      @default(KASIR)
  /// Kasir is tied to one outlet; owner may be unassigned (all outlets).
  outletId  String?
  outlet    Outlet?   @relation(fields: [outletId], references: [id])
  isActive  Boolean   @default(true)
  /// Soft-delete (manajemen akun): riwayat transaksi & jejak audit tetap
  /// menunjuk akun ini, tapi login ditolak dan sesi diputus jwt-recheck.
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions   Transaction[]
  stockMovements StockMovement[]
  auditEvents    AuditEvent[]

  @@index([outletId])
}

/// Physical store location — supports the multi-outlet roadmap.
model Outlet {
  id           String        @id @default(uuid())
  name         String
  address      String?
  phone        String?
  /// Uploaded UMKM logo (PNG/JPEG/WebP bytes). Printed at the top-left
  /// of the receipt in full color, shown in app headers, and used as
  /// the browser favicon. Null = receipts print the outlet name
  /// centered, the classic warung look.
  logoData     Bytes?
  logoMimeType String?
  /// Bumped on every logo change so /api/outlet/logo?v=N cache-busts.
  logoVersion  Int           @default(0)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  users        User[]
  products     Product[]
  transactions Transaction[]
  auditEvents  AuditEvent[]
}

/// Jejak audit append-only (Task 34): SEMUA aksi penting tercatat —
/// transaksi, refund, penyajian, gerakan stok, produk, pengaturan,
/// akun, dan percobaan login. Baris tidak pernah diubah/dihapus;
/// konsol developer (Fase B) menjadikannya sumber query + CSV owner.
model AuditEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  /// Siapa yang melakukan (null = sistem / login tanpa akun valid).
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?
  /// Outlet tempat aksi terjadi (null = aksi lintas-outlet / login).
  outlet    Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  outletId  String?
  /// Nama aksi stabil, mis. TRANSACTION_CREATE, STOCK_IN, LOGIN_FAILED.
  action    String
  /// Penunjuk entitas "jenis:id", mis. "transaction:<uuid>".
  entity    String?
  /// Satu kalimat manusiawi untuk dibaca manusia.
  summary   String
  /// Detail tambahan (JSON primitif).
  meta      Json?

  @@index([createdAt])
  @@index([outletId])
  @@index([action])
}

/// Product grouping for the cashier UI and reports.
model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  products Product[]
}

/// Satuan produk (pcs, box, kg, ...). Master data yang dikelola penjual
/// lewat form produk — mengikuti alur Category. Product.unit tetap
/// string snapshot (tanpa relasi) agar data lama tetap aman.
model Unit {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)
}

/// Sellable item. Stock is tracked PER OUTLET.
model Product {
  id         String    @id @default(uuid())
  sku        String    @unique
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  outletId   String
  outlet     Outlet    @relation(fields: [outletId], references: [id])
  /// Selling price (Rp) — Decimal(12,2), never Float for money.
  price      Decimal   @db.Decimal(12, 2)
  /// Purchase cost (Rp) — used for profit reports.
  cost       Decimal   @db.Decimal(12, 2)
  stock      Int       @default(0)
  /// Low-stock alert threshold used by the restock flow.
  minStock   Int       @default(5)
  unit       String    @default("pcs")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactionItems TransactionItem[]
  images           ProductImage[]
  stockMovements   StockMovement[]

  @@index([outletId])
  @@index([categoryId])
}

/// Product photo uploaded through the owner image editor. Stored as
/// bytes so images live transactionally with the product (single
/// writer, multi-outlet ready) and survive container rebuilds in the
/// Docker demo stack. Served by /api/images/[id] with immutable
/// caching — ids never change content, a new upload is a new row.
model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Edited JPEG bytes (already cropped/rotated by the client editor).
  data      Bytes
  mimeType  String   @default("image/jpeg")
  /// Pixel dimensions of the stored image (for UI hints and audits).
  width     Int?
  height    Int?
  /// Position among the product's photos; the manager can reorder.
  sortOrder Int      @default(0)
  /// Chosen thumbnail. Invariant: exactly one image of a product with
  /// at least one image is the thumbnail; the first photo is the
  /// default until the owner picks another.
  isThumb   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

/// Audit trail of every stock change, so the current stock is always
/// explainable: opening balance + IN - SALE (+/- ADJUST) = stock now.
/// SALE rows are created inside the same database transaction as the
/// receipt they belong to; IN rows come from the owner restock flow and
/// carry an optional per-unit cost snapshot for profit reporting.
model StockMovement {
  id            String            @id @default(uuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          StockMovementType
  /// Always a positive number; the type decides the direction.
  quantity      Int
  /// Purchase cost per unit at restock time (Rp snapshot). Null on sales.
  unitCost      Decimal?          @db.Decimal(12, 2)
  note          String?
  /// Who performed the movement. Null for backfilled or system rows.
  userId        String?
  user          User?             @relation(fields: [userId], references: [id])
  /// Set on SALE rows so the timeline can link back to the receipt.
  transactionId String?
  transaction   Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// One sales receipt — created atomically together with its items.
model Transaction {
  id            String            @id @default(uuid())
  /// Human-readable receipt code, e.g. TRX-20261020-0001 (app-generated).
  code          String            @unique
  outletId      String
  outlet        Outlet            @relation(fields: [outletId], references: [id])
  cashierId     String
  cashier       User              @relation(fields: [cashierId], references: [id])
  paymentMethod PaymentMethod     @default(CASH)
  status        TransactionStatus @default(COMPLETED)
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  paidAmount    Decimal           @db.Decimal(12, 2)
  changeAmount  Decimal           @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime          @default(now())

  // Verifikasi serah terima v2 (anti-fraud). Kode 8 karakter tanpa
  // huruf/angka ambigu tercetak di struk dan masuk ke QR — TAPI kode
  // ini TIDAK jadi satu-satunya kunci: kurir yang login selalu bisa
  // melihat semua kode hari ini di /owner/verify, jadi penjual tidak
  // mungkin "lupa kode klaim". Struk boleh tidak dibawa pembeli;
  // konfirmasi bisa lewat tanda tangan di layar kurir atau HP pembeli.
  claimCode           String?   @unique
  // null = belum ada aktivitas | COURIER_CLAIMED = kurir menandai
  // "sudah diantar" TANPA tanda tangan pembeli (bukti lemah) |
  // CONFIRMED = pembeli konfirmasi dengan tanda tangan (bukti kuat) |
  // DISPUTED = pembeli membantah pernah menerima (sengketa).
  handoverStatus      String?
  handoverConfirmedAt DateTime?
  // User id staf yang mencatat konfirmasi di layar kurir. Null berarti
  // konfirmasi dilakukan pembeli sendiri dari HP-nya (metode PUBLIC).
  handoverConfirmedBy String?

  items          TransactionItem[]
  stockMovements StockMovement[]
  handoverEvents HandoverEvent[]

  @@index([outletId, createdAt]) // daily reports + ML time-series queries
  @@index([cashierId])
}

/// Line item of a transaction — quantity x price snapshot.
model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  /// Price AT THE TIME OF SALE — historical snapshot.
  priceAtSale   Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId]) // ML: per-product demand aggregation
}

/// Jejak kejadian serah terima — APPEND-ONLY: baris tidak pernah
/// di-update atau dihapus, sehingga tidak bisa dimanipulasi pihak mana
/// pun. Ini yang menang kalau ada sengketa "saya tidak pernah terima".
/// Backend Python nanti bisa baca tabel ini (read-only) untuk deteksi
/// pola kurir curang: klaim berlebihan vs konfirmasi pembeli.
model HandoverEvent {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// BUYER_CONFIRM = pembeli tanda tangan | COURIER_CLAIM = klaim
  /// kurir tanpa tanda tangan | BUYER_DISPUTE = pembeli membantah.
  kind          String
  /// IN_APP = terjadi di layar kurir (login) | PUBLIC = dari HP pembeli.
  method        String?
  /// OWNER | KASIR | BUYER.
  actorRole     String?
  /// User id staf (null untuk pembeli).
  actorId       String?
  /// Nama pembeli yang diketik saat konfirmasi (opsional).
  buyerName     String?
  /// Data URL PNG tanda tangan pembeli (maks ±300KB).
  signatureData String?
  note          String?
  userAgent     String?
  ip            String?
  createdAt     DateTime    @default(now())

  @@index([transactionId, createdAt])
}
