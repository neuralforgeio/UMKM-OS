// =====================================================================
// UMKM OS — database schema (Prisma)
// ---------------------------------------------------------------------
// The schema is OWNED BY THE FRONTEND (blueprint, chapter 8): the
// Next.js app is the single writer, while the FastAPI ML service
// connects READ-ONLY for forecasting queries.
//
// Conventions:
//   - Money columns use Decimal(12,2) — NEVER Float for currency.
//   - ids are UUIDs generated by Prisma (client side).
//   - TransactionItem stores priceAtSale as a historical snapshot, so
//     old receipts stay accurate even when product prices change later.
//   - Soft deletes via isActive — sales history must never be lost.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

/// Application roles — drives RBAC in frontend pages and API routes.
enum Role {
  OWNER // full access: all outlets, reports, settings, user management
  KASIR // point-of-sale access for their assigned outlet
}

/// Payment methods accepted at the cashier.
enum PaymentMethod {
  CASH
  QRIS
  DEBIT
}

/// Lifecycle of a transaction.
enum TransactionStatus {
  COMPLETED
  REFUNDED
}

// ---------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------

/// Application user (owner or cashier).
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  /// Bcrypt hash — the plain password is never stored.
  password  String
  role      Role     @default(KASIR)
  /// Kasir is tied to one outlet; owner may be unassigned (all outlets).
  outletId  String?
  outlet    Outlet?  @relation(fields: [outletId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([outletId])
}

/// Physical store location — supports the multi-outlet roadmap.
model Outlet {
  id        String   @id @default(uuid())
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users        User[]
  products     Product[]
  transactions Transaction[]
}

/// Product grouping for the cashier UI and reports.
model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)

  products Product[]
}

/// Sellable item. Stock is tracked PER OUTLET.
model Product {
  id         String    @id @default(uuid())
  sku        String    @unique
  name       String
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  outletId   String
  outlet     Outlet    @relation(fields: [outletId], references: [id])
  /// Selling price (Rp) — Decimal(12,2), never Float for money.
  price      Decimal   @db.Decimal(12, 2)
  /// Purchase cost (Rp) — used for profit reports.
  cost       Decimal   @db.Decimal(12, 2)
  stock      Int       @default(0)
  /// Low-stock alert threshold used by the restock flow.
  minStock   Int       @default(5)
  unit       String    @default("pcs")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactionItems TransactionItem[]

  @@index([outletId])
  @@index([categoryId])
}

/// One sales receipt — created atomically together with its items.
model Transaction {
  id            String            @id @default(uuid())
  /// Human-readable receipt code, e.g. TRX-20261020-0001 (app-generated).
  code          String            @unique
  outletId      String
  outlet        Outlet            @relation(fields: [outletId], references: [id])
  cashierId     String
  cashier       User              @relation(fields: [cashierId], references: [id])
  paymentMethod PaymentMethod     @default(CASH)
  status        TransactionStatus @default(COMPLETED)
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @db.Decimal(12, 2) @default(0)
  total         Decimal           @db.Decimal(12, 2)
  paidAmount    Decimal           @db.Decimal(12, 2)
  changeAmount  Decimal           @db.Decimal(12, 2)
  note          String?
  createdAt     DateTime          @default(now())

  items         TransactionItem[]

  @@index([outletId, createdAt]) // daily reports + ML time-series queries
  @@index([cashierId])
}

/// Line item of a transaction — quantity x price snapshot.
model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  quantity      Int
  /// Price AT THE TIME OF SALE — historical snapshot.
  priceAtSale   Decimal     @db.Decimal(12, 2)
  subtotal      Decimal     @db.Decimal(12, 2)

  @@index([transactionId])
  @@index([productId]) // ML: per-product demand aggregation
}
