# =====================================================================
# UMKM OS Backend — environment template
# ---------------------------------------------------------------------
# 1. Copy this file:  Copy-Item .env.example .env   (PowerShell)
# 2. Fill in real values for your environment.
# 3. .env is git-ignored — never commit real credentials.
# =====================================================================

# ---------------------------------------------------------------------
# Service identity (safe defaults — override if needed)
# ---------------------------------------------------------------------
APP_NAME=UMKM OS Backend
VERSION=0.1.0

# Running mode: development | production | test
ENVIRONMENT=development

# Auto-reload + verbose errors. ALWAYS false in production.
DEBUG=true

# ---------------------------------------------------------------------
# API routing
# ---------------------------------------------------------------------
# Every endpoint lives under {API_PREFIX}/{API_VERSION}/* (e.g. /api/v1/*).
# Bump API_VERSION only for breaking changes; add a v2 aggregator in
# app/api/ and keep v1 alive during the migration window.
API_PREFIX=/api
API_VERSION=v1

# ---------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------
# Use 127.0.0.1 for local dev; must be 0.0.0.0 inside Docker.
HOST=127.0.0.1
PORT=8000

# ---------------------------------------------------------------------
# Database — REQUIRED. The app refuses to start without it.
# The ML service connects READ-ONLY; the schema is owned by Prisma
# (frontend side). Format:
#   postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# Keep USER/PASSWORD/DBNAME in sync with the root .env (Docker Compose).
# ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://umkm:umkm_dev_password@localhost:5432/umkmos

# ---------------------------------------------------------------------
# Security — origins allowed to call this API (CORS).
# Comma-separated if more than one:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# ML v3.0.0 — engine Prophet per-outlet (opsional; default aktif)
# ---------------------------------------------------------------------
# false = murni statistical: tanpa training Prophet, tanpa joblib.
# Import prophet yang gagal pun otomatis mem-fallback ke jalur itu.
# PROPHET_ENABLED=true

# Direktori artefak model (joblib) per outlet. Default relatif
# "mlmodels" -> backend/mlmodels saat dev lokal; di docker diganti
# /app/mlmodels via volume bernama (docker-compose.yml).
# ML_MODEL_DIR=mlmodels

# ---------------------------------------------------------------------
# Asisten AI v3.1.0 — LLM OPSIONAL (kosong = Mode Data tanpa biaya)
# ---------------------------------------------------------------------
# Endpoint standar OpenAI-compatible => agnostik penyedia:
#   Groq     : https://api.groq.com/openai/v1
#   OpenAI   : https://api.openai.com/v1
#   Ollama   : http://localhost:11434/v1 (kunci bisa kosong tapi
#              tetap isi apa pun agar terdeteksi "terkonfigurasi")
# Saklar total: false = Mode Data murni walau ketiga env terisi.
# LLM_ENABLED=true
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# Batas laju per pengguna per jam + umur cache jawaban (detik).
# ASSISTANT_RATE_LIMIT_PER_HOUR=12
# ASSISTANT_CACHE_SECONDS=600
# Kunci antar-layanan frontend<->ml-service (di compose diisi dari
# AUTH_SECRET root). Dev lokal tanpa docker: kosong = pintu terbuka.
# INTERNAL_API_KEY=
