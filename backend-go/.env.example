# Salin file ini jadi .env lalu isi nilai asli Anda — .env TIDAK masuk git
# (sudah ada di .gitignore). Semua nilai di bawah hanyalah CONTOH, bukan
# kredensial yang bisa dipakai orang lain.
#
# CATATAN DOCKER: saat stack berjalan lewat docker-compose (dari root
# proyek), SELURUH variabel ini datang dari root .env / docker-compose.yml
# — file .env ini hanya dipakai saat menjalankan `go run .` secara lokal.
# Kredensial developer agar sinkron antara dua mode itu: samakan
# DEVELOPER_EMAIL / DEVELOPER_PASSWORD di sini dengan DEV_SEED_EMAIL /
# DEV_SEED_PASSWORD di root .env (di Docker, compose melakukannya otomatis).

# Port server API Go
PORT=8080

# Asal frontend yang diizinkan CORS
CLIENT_URL=http://localhost:3000

# Koneksi PostgreSQL (ganti user/password/port sesuai mesin Anda;
# lokal biasanya 5432, docker compose memakai 5433 di sisi host)
DATABASE_URL=postgres://umkm:GANTI_PASSWORD_ANDA@localhost:5432/umkmos?sslmode=disable

# Kunci tanda tangan token JWT — WAJIB diganti dengan string acak panjang
# (mis. hasil: python -c "import secrets; print(secrets.token_urlsafe(36))")
# Di Docker, compose otomatis memakai AUTH_SECRET dari root .env.
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
JWT_EXPIRES_H=24

# Akun OWNER awal — hanya dipakai saat database masih kosong (seed).
# Biarkan OWNER_PASSWORD kosong untuk mendapat password acak 16 karakter
# yang dicetak SEKALI di layar konsol saat boot pertama, lalu ganti
# lewat POST /api/v1/auth/change-password setelah login.
OWNER_EMAIL=owner@umkm.local
OWNER_PASSWORD=

# Akun DEVELOPER (konsol lintas outlet) — dibuat hanya bila KEDUANYA
# terisi. Sengaja TIDAK ADA default: repo ini publik, password apa pun
# yang tertulis di kode langsung menjadi pintu belakang.
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# Folder penyimpanan file log harian (.log + .csv)
LOG_DIR=logs
