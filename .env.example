# =====================================================================
# UMKM OS — Docker Compose environment template (repository root)
# ---------------------------------------------------------------------
# docker compose automatically reads every variable in this file.
# Keep USER / PASSWORD / DBNAME in sync with backend/.env — the host-run
# backend must connect with the same credentials.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL (service "db")
# ---------------------------------------------------------------------
POSTGRES_USER=umkm

# Choose a strong password for anything beyond local development.
POSTGRES_PASSWORD=umkm_dev_password

POSTGRES_DB=umkmos

# Host port for the CONTAINERIZED PostgreSQL.
# Keep 5433 if a native PostgreSQL installation already owns 5432 on
# this machine — otherwise 5432 works too.
POSTGRES_PORT=5433

# ---------------------------------------------------------------------
# Backend (service "backend")
# ---------------------------------------------------------------------
BACKEND_PORT=8000
