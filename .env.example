# Docker Compose environment template - copy to .env and fill in real values

# PostgreSQL — dipakai BERGANDA oleh seluruh service lewat jaringan
# internal docker (db:5432). Port di sisi HOST adalah 5433 supaya tidak
# bentrok dengan PostgreSQL lokal yang berjalan di 5432.
POSTGRES_USER=umkm
POSTGRES_PASSWORD=umkmindo45
POSTGRES_DB=umkmos

# 5433 avoids the local PostgreSQL; 8000 and 3000 match local dev,
# so stop uvicorn and next dev before bringing the stack up
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64')"
# Secret ini menandatangani cookie sesi NextAuth (frontend) DAN token JWT
# backend-go di Docker — satu tempat rotasi untuk keduanya.
AUTH_SECRET=replace-with-your-generated-secret

# Akun developer bootstrap — dipakai backend-go membuat akun DEVELOPER
# pertama (login konsol dev) saat database baru dibuat.
# Repo ini PUBLIK: JANGAN isi nilai asli di sini, cukup salin dua baris
# ini ke .env lokal dan isi di sana.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# ---------------------------------------------------------------------
# OPSIONAL (hapus tanda # untuk memakai) — tidak wajib ada di .env
# ---------------------------------------------------------------------

# Password akun OWNER pertama milik backend-go. Dikosongkan = password
# acak 16 karakter yang dicetak SEKALI di `docker compose logs
# backend-go` saat database pertama kali dibuat, lalu wajib diganti
# setelah login.
#OWNER_EMAIL=owner@umkm.local
#OWNER_PASSWORD=

# ---------------------------------------------------------------------
# OPSIONAL — Asisten AI (frontend v2.4.0 + ml-service v3.1.0)
# ---------------------------------------------------------------------
# LLM agnostik penyedia OpenAI-compatible. Contoh:
#   Groq     : https://api.groq.com/openai/v1   (cepat & murah)
#   OpenAI   : https://api.openai.com/v1
#   OpenRouter/Together: URL /v1 masing-masing
#   Ollama   : http://host.docker.internal:11434/v1 (lokal, tanpa biaya)
# Kosongkan LLM_API_KEY => asisten tetap hidup dalam "Mode Data"
# (jawaban template dari data warung, tanpa biaya, tanpa internet).
#LLM_ENABLED=true
#LLM_BASE_URL=
#LLM_API_KEY=
#LLM_MODEL=
# Batas laju per pengguna (per jam) dan umur cache jawaban (detik).
#ASSISTANT_RATE_LIMIT_PER_HOUR=12
#ASSISTANT_CACHE_SECONDS=600
# Kunci antar-layanan frontend<->ml-service. Default compose: AUTH_SECRET
# di atas otomatis mengisi INTERNAL_API_KEY kedua layanan. Di luar docker
# (dev lokal) kosong = pintu terbuka localhost.
#INTERNAL_API_KEY=
