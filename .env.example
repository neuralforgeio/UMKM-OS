# Docker Compose environment template - copy to .env and fill in real values

# Demo credential, kept identical to backend/.env and frontend/.env.local
POSTGRES_USER=umkm
POSTGRES_PASSWORD=umkmindo45
POSTGRES_DB=umkmos

# 5433 avoids the local PostgreSQL; 8000 and 3000 match local dev,
# so stop uvicorn and next dev before bringing the stack up
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-your-generated-secret

# Akun developer bootstrap (Task 34) — dibuat otomatis oleh service
# migrate saat seeding. Repo ini PUBLIK: JANGAN isi nilai asli di sini,
# cukup salin dua baris ini ke .env lokal dan isi di sana.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
