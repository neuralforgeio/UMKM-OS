# Docker Compose environment template - copy to .env and fill in real values

# PostgreSQL — dipakai BERGANDA oleh seluruh service lewat jaringan
# internal docker (db:5432). Port di sisi HOST adalah 5433 supaya tidak
# bentrok dengan PostgreSQL lokal yang berjalan di 5432.
POSTGRES_USER=umkm
POSTGRES_PASSWORD=umkmindo45
POSTGRES_DB=umkmos

# 5433 avoids the local PostgreSQL; 8000 and 3000 match local dev,
# so stop uvicorn and next dev before bringing the stack up
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64')"
# Secret ini menandatangani cookie sesi NextAuth (frontend) DAN token JWT
# backend-go di Docker — satu tempat rotasi untuk keduanya.
AUTH_SECRET=replace-with-your-generated-secret

# Akun developer bootstrap — nilai yang sama dipakai DUA kali: oleh
# service migrate (seed Prisma, konsol developer) dan oleh backend-go
# (login), jadi kredensialnya selalu identik.
# Repo ini PUBLIK: JANGAN isi nilai asli di sini, cukup salin dua baris
# ini ke .env lokal dan isi di sana.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# ---------------------------------------------------------------------
# OPSIONAL (hapus tanda # untuk memakai) — tidak wajib ada di .env
# ---------------------------------------------------------------------

# Password akun OWNER pertama milik backend-go. Dikosongkan = password
# acak 16 karakter yang dicetak SEKALI di `docker compose logs
# backend-go` saat database pertama kali dibuat, lalu wajib diganti
# setelah login.
#OWNER_EMAIL=owner@umkm.local
#OWNER_PASSWORD=

# Password akun demo Prisma (busari@warung.id / rizky@warung.id) saat
# menjalankan prisma/seed.ts — kosong = acak, dicetak sekali di log
# service migrate.
#SEED_OWNER_PASSWORD=
#SEED_KASIR_PASSWORD=
