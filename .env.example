# Contoh variabel lingkungan UMKM OS (v1.0.0).
#
# Salin ke .env lalu sesuaikan. Mode AI OSCAR paling mudah diaktifkan
# lewat UI: Pengaturan -> Asisten AI (tersimpan di volume docker,
# menimpa nilai env di bawah tanpa restart).
#
# AUTH_SECRET         : kunci sesi NextAuth + X-Internal-Key antar layanan.
# DATABASE_URL        : Postgres utama (skema milik backend-go).
# BACKEND_URL         : alamat layanan ML (FastAPI) dari frontend.
# LLM_BASE_URL        : penyedia LLM standar OpenAI compatible.
# LLM_API_KEY         : kunci penyedia (Groq/OpenAI/OpenRouter; kosong
#                       untuk Ollama lokal).
# LLM_MODEL           : nama model, mis. openai/gpt-oss-20b di Groq.
# LLM_ENABLED         : false mematikan Mode AI (asisten jatuh ke Mode
#                       Data yang menjawab murni dari SQL).
# ML_AUTO_TRAIN       : latih ulang model ramalan otomatis tiap 6 jam.

AUTH_SECRET=ganti-dengan-kunci-rahasia-anda
DATABASE_URL=postgresql://umkm:umkm@db:5432/umkmos
BACKEND_URL=http://backend:8000
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
ML_AUTO_TRAIN=true
